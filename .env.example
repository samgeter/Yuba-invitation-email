# Gmail SMTP Configuration
# IMPORTANT: You must generate an App Password for Gmail
# 
# Steps to get Gmail App Password:
# 1. Go to your Google Account settings
# 2. Navigate to Security > 2-Step Verification (enable if not already)
# 3. Go to Security > App passwords
# 4. Generate a new app password for "Mail"
# 5. Copy the 16-character password and paste it below
#
# DO NOT use your regular Gmail password here!

GMAIL_USER=samget2010@gmail.com
GMAIL_PASS=your-app-password-here
